datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


generator client {
  provider = "prisma-client-js"
}

// NOTE: The `Role` enum has been converted to a String for SQLite compatibility.
// In your application logic, you should validate that this field is either "ADMIN" or "STAFF".
// enum Role {
//   ADMIN
//   STAFF
// }

// MODELS

model Shop {
  id            String     @id @default(uuid())
  shop_name     String
  shop_phone    String
  shop_email    String?
  shop_address  String?
  shop_logo_url String?
  // NOTE: The `shop_images` field is stored as a String.
  // You must use JSON.stringify() and JSON.parse() in your application code.
  shop_images   String?    // Originally Json?
  is_active     Boolean    @default(true)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  // Relations
  users         User[]
  products      Product[]
  catalogs      Catalog[]
  orders        Order[]
}

model User {
  id                String    @id @default(uuid())
  shop_id           String
  role              String    // Originally Role enum
  name              String
  phone             String
  email             String?   @unique
  profile_image_url String?
  is_active         Boolean   @default(true)
  last_login_at     DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  // Relations
  shop              Shop           @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  refresh_tokens    RefreshToken[]
  created_catalogs  Catalog[]      @relation("CatalogCreator")

  // Constraints & Indexes
  @@unique([shop_id, phone], name: "unique_phone_per_shop")
}

model OtpSession {
  id          String   @id @default(uuid())
  phone       String
  otp_code    String
  expires_at  DateTime
  is_used     Boolean  @default(false)
  created_at  DateTime @default(now())
}

model RefreshToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String
  expires_at DateTime
  is_revoked Boolean  @default(false)
  created_at DateTime @default(now())

  // Relations
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Indexes
  @@index([user_id])
}

model Product {
  id              String   @id @default(uuid())
  shop_id         String
  sku_code        String?
  product_name    String
  description     String?
  price           Float    // Originally Decimal
  currency        String   @default("INR")
  stock_quantity  Int      @default(0)
  is_active       Boolean  @default(true)
  thumbnail_url   String?
  // NOTE: The `image_urls` field is stored as a String.
  // You must use JSON.stringify() and JSON.parse() in your application code.
  image_urls      String?  // Originally Json?
  category        String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  shop            Shop             @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  catalog_items   CatalogProduct[]

  // Indexes
  @@index([shop_id])
}

model Catalog {
  id           String   @id @default(uuid())
  shop_id      String
  catalog_name String
  catalog_slug String   @unique
  is_active    Boolean  @default(true)
  created_by   String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relations
  shop          Shop             @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  creator       User             @relation("CatalogCreator", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Cascade)
  products      CatalogProduct[]
  orders        Order[]

  // Indexes
  @@index([shop_id])
  @@index([created_by])
}

model CatalogProduct {
  id            String   @id @default(uuid())
  catalog_id    String
  product_id    String
  display_order Int      @default(0)
  created_at    DateTime @default(now())

  // Relations
  catalog       Catalog @relation(fields: [catalog_id], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  // Constraints & Indexes
  @@unique([catalog_id, product_id], name: "unique_product_per_catalog")
  @@index([product_id])
}

model Order {
  id            String   @id @default(uuid())
  shop_id       String
  catalog_id    String
  // NOTE: The `order_items` field is stored as a String.
  // You must use JSON.stringify() and JSON.parse() in your application code.
  order_items   String   // Originally Json
  total_items   Int?
  order_source  String   @default("CATALOG_LINK")
  whatsapp_sent Boolean  @default(false)
  created_at    DateTime @default(now())

  // Relations
  shop          Shop    @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  catalog       Catalog @relation(fields: [catalog_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Indexes
  @@index([shop_id])
  @@index([catalog_id])
}
